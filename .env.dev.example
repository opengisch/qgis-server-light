#########
# General Compose variables
#########

# choose platform you want to run on if necessary (linux/amd64 is default)
# others have to be checked if availble
PLATFORM=linux/amd64

# this way we tell compose to overwrite/extend compose with compose.dev
# and still we just do a docker compose up -d (everything else runs automagically)
COMPOSE_FILE=compose.yml:compose.dev.yml

#########
# Build time args
#########

# setting this up in sync with you local host system uid/gid allows
# transparent file permissions inside and outside the container
UID=1000
GID=1000
PYTHON_VERSION=3.12

#########
# QGIS-Server-Light runtime settings
#########

# loglevel of qsl, might be info, warning, debug
QSL_LOG_LEVEL=debug

# switches the internal pydev-server on (1) or off (0)
DEBUGPY=0
# wait until a client connects to the debugging session (1) or just continue (0)
DEBUGPY_WAIT=0

# switch to start the service inside the container (1)
# or just idle forever (0), this is useful when you want
# to start the service yourself for e.g. debug sessions
# via remote debugging capabilities of your favourite IDE
# when you use 0 here, you probably want to switch both DEBUGPY
# variables to 0 too, since you are using your IDE's native debugger then
DEV_AUTOSTART=0


#########
# Local Paths to be mounted as volumes (Worker AND Exporter)
#########

# both paths point to the test folder in this project, you may want to point this
# to any absolute path on you system (be careful and mind about the risks!)
LOCAL_PROJECTS=./tests/resources/projects
LOCAL_SVGS=./tests/resources/svg
